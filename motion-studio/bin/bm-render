#!/usr/bin/env bash
# Render a Motion Studio project to a finished MP4 (video + original music/sfx [+ voice]), with QC.
#   bin/bm-render <project-dir> [--fps 30] [--voice vo.wav] [--blur N] [--qc-times "1 3 5 ..."]   (--blur: motion blur, N sub-frames)
# Steps: cue list + key-frame sheet -> frame-exact export (resource-limited, measured)
#        -> sound design -> mux -> automatic QC. Outputs land in <project>/out/.
set -euo pipefail
HERE=$(cd "$(dirname "$0")/.." && pwd)
P=$(cd "$1" && pwd); shift
FPS=30; VOICE=""; QCT=""
while (( $# )); do case $1 in --fps) FPS=$2; shift 2;; --voice) VOICE=$2; shift 2;; --qc-times) QCT=$2; shift 2;; --blur) export BM_BLUR=$2; shift 2;; *) echo "unknown $1"; exit 2;; esac; done
NAME=$(basename "$P"); OUT="$P/out"; mkdir -p "$OUT"
echo "== 1/5 cues + key frames"
node "$HERE/tools/snap.mjs" "$P" "$OUT/check" ${QCT:-0.5} >/dev/null
echo "== 2/5 frame-exact export (limited: ${BM_CORES:-auto} cores, ${BM_MEM_MAX:-6G})"
"$HERE/bin/bm-safe" --metrics "$OUT/render-metrics.json" -- node "$HERE/tools/export.mjs" "$P" "$OUT/video-only.mp4" "$FPS"
echo "== 3/5 sound design"
python3 "$HERE/tools/sound.py" "$OUT/check/cues.json" "$OUT/audio.wav" ${VOICE:+--voice "$VOICE"}
echo "== 4/5 mux"
ffmpeg -v error -y -i "$OUT/video-only.mp4" -i "$OUT/audio.wav" -map 0:v -map 1:a -c:v copy -c:a aac -b:a 192k -shortest -movflags +faststart "$OUT/$NAME.mp4"
echo "== 5/5 QC"
read -r W H < <(node -e "const s=require('fs').readFileSync('$P/index.html','utf8');const m=s.match(/W:\s*(\d+),\s*H:\s*(\d+)/);console.log(m?m[1]+' '+m[2]:'1080 1920')")
"$HERE/tools/qc.sh" "$OUT/$NAME.mp4" "${W}x${H}" "$FPS" | tee "$OUT/qc.txt"
echo "done: $OUT/$NAME.mp4"
